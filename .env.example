# ============================================================
# DevForge AI — Frontend Web (Vite)
# ============================================================
# Copiar a .env y ajustar según entorno.
# Vite expone al cliente SOLO las variables con prefijo VITE_.
# ============================================================

# --- Backend API (REST) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Backend WebSocket (colaboración) ---
VITE_WS_BASE_URL=ws://localhost:8000

# --- Modo de operación ---
# development | production
VITE_APP_ENV=development

# --- Feature flags ---
# Activar/desactivar funcionalidades sin recompilar
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_AI_VISION=true

# --- Timeouts y límites ---
VITE_API_TIMEOUT_MS=30000
VITE_WS_RECONNECT_MAX_ATTEMPTS=10
VITE_WS_RECONNECT_INITIAL_DELAY_MS=1000

# --- Versionado ---
VITE_APP_VERSION=0.1.0