# ============================================================
# DevForge AI — Frontend Web · Producción
# ============================================================
# Uso: crear .env.production.local (Vite lo lee automáticamente en
# `vite build`). No commitear.

VITE_API_BASE_URL=https://api-devforgeai.duckdns.org/api/v1
VITE_WS_BASE_URL=wss://api-devforgeai.duckdns.org

# --- Modo local (Camino A): si la VM no responde, la PWA intenta el
# backend local de la laptop del arquitecto (INSTALACION.md del backend)
VITE_LOCAL_API_BASE_URL=http://localhost:8000/api/v1
VITE_LOCAL_WS_BASE_URL=ws://localhost:8000

VITE_APP_ENV=production

VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_AI_VISION=true

VITE_API_TIMEOUT_MS=30000
VITE_WS_RECONNECT_MAX_ATTEMPTS=10
VITE_WS_RECONNECT_INITIAL_DELAY_MS=1000

VITE_APP_VERSION=0.2.0